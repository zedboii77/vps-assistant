# VPS Assistant — reverse proxy template
# Adjust server_name, then: certbot --nginx -d vps.example.com
# (certbot will add the 443 server block + redirect automatically)

server {
    listen 80;
    listen [::]:80;
    server_name vps.example.com;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vps.example.com;

    ssl_certificate /etc/letsencrypt/live/vps.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vps.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2M;

    location / {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE streaming: long read timeout + buffering off
        proxy_buffering off;
        proxy_read_timeout 600;
        proxy_send_timeout 600;
    }
}
