# Copy to .env and fill in, or export these however you launch the server.
# server.py reads OPENROUTER_API_KEY from its process environment; if you use
# systemd with EnvironmentFile=.env it will be picked up automatically.
OPENROUTER_API_KEY=
VPSA_PORT=8095
VPSA_HOST=127.0.0.1
VPSA_MODEL=stealth/ox-alpha
